# Copy to backend/.env and fill in. Never commit the real .env.

# --- core -----------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
DATABASE_URL=postgres://sacc:CHANGE_ME@localhost:5432/sacc
DB_CONN_MAX_AGE=60

# --- CORS / CSRF ----------------------------------------------------------
# The origins the public site is served from. Ignored in dev, where all
# origins are allowed so the static page can be opened straight off disk.
CORS_ALLOWED_ORIGINS=https://saccgroup.net,https://www.saccgroup.net
CSRF_TRUSTED_ORIGINS=https://saccgroup.net,https://www.saccgroup.net

# --- email ----------------------------------------------------------------
# Dev prints mail to the console. For real delivery switch the backend to SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SACC Website <no-reply@saccgroup.net>

# Who gets notified when a quote request or job application arrives.
LEAD_NOTIFICATION_RECIPIENTS=info@saccgroup.net

# --- tuning ---------------------------------------------------------------
SITE_BUNDLE_CACHE_SECONDS=300
MAX_CV_UPLOAD_MB=5
THROTTLE_QUOTE_REQUEST=10/hour
THROTTLE_JOB_APPLICATION=5/hour
LOG_LEVEL=INFO

# --- production only ------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
