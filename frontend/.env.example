# The Django backend the site talks to.
#
# Development does not need this — `npm run dev` proxies /api to the backend
# (target set in vite.config.js), so requests are same-origin.
#
# Production does not need it either: backend/render.yaml sets VITE_API_URL
# for the static-site build.
#
# Copy this to .env (gitignored) only if you want `npm run build` /
# `npm run preview` to point somewhere specific locally.
VITE_API_URL=https://sacc-backend-894t.onrender.com
